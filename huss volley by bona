local A="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local M={}
for i=1,64 do M[A:byte(i)]=i-1 end
local O,n,acc,bits={},0,0,0
local kl=#K
for i=1,#S do
    local v=M[S:byte(i)]
    if v then
        acc=acc*64+v
        bits=bits+6
        if bits>=8 then
            bits=bits-8
            local p=2^bits
            local b=math.floor(acc/p)
            acc=acc%p
            n=n+1
            O[n]=string.char(bit32.bxor(b,K[(n-1)%kl+1]))
        end
    end
end
local f,e=loadstring(table.concat(O))
if not f then warn("BONA load error: "..tostring(e)) return end
return f()
