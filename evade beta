local bubbles = {}
local bubbleRng = Random.new()
local function respawnBubble(b, initial)
local size = bubbleRng:NextInteger(12, 46)
b.size = size
b.x = bubbleRng:NextNumber(0, 1)
b.y = initial and bubbleRng:NextNumber(0, 1) or 1.08
b.speed = bubbleRng:NextNumber(0.04, 0.13)
b.sway = bubbleRng:NextNumber(0.01, 0.035)
b.phase = bubbleRng:NextNumber(0, 6.28)
b.frame.Size = UDim2.fromOffset(size, size)
b.frame.BackgroundTransparency = bubbleRng:NextNumber(0.8, 0.93)
end
for i = 1, 18 do
local f = Instance.new("Frame")
f.BackgroundColor3 = Color3.fromRGB(90, 185, 255)
f.BorderSizePixel = 0
f.Active = false
f.Parent = BubbleLayer
local fc = Instance.new("UICorner")
fc.CornerRadius = UDim.new(1, 0)
fc.Parent = f
local fs = Instance.new("UIStroke")
fs.Color = Color3.fromRGB(225, 245, 255)
fs.Transparency = 0.6
fs.Thickness = 1
fs.Parent = f
local b = {frame = f}
respawnBubble(b, true)
bubbles[i] = b
end
local bubbleConn = RunService.Heartbeat:Connect(function(dt)
if not MainFrame.Visible then return end
local w, h = BubbleLayer.AbsoluteSize.X, BubbleLayer.AbsoluteSize.Y
local t = os.clock()
for _, b in ipairs(bubbles) do
b.y -= b.speed * dt
if b.y < -0.1 then
respawnBubble(b, false)
end
local x = (b.x + math.sin(t + b.phase) * b.sway) * w
b.frame.Position = UDim2.fromOffset(x - b.size / 2, b.y * h)
end
end)
local dragging, dragInput, dragStart, startPos
local function updateDrag(input)
local delta = input.Position - dragStart
MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
end
MainFrame.InputBegan:Connect(function(input)
if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
dragging = true
dragStart = input.Position
startPos = MainFrame.Position
input.Changed:Connect(function()
if input.UserInputState == Enum.UserInputState.End then
dragging = false
end
end)
end
end)
MainFrame.InputChanged:Connect(function(input)
if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
dragInput = input
end
end)
UserInputService.InputChanged:Connect(function(input)
if input == dragInput and dragging then
updateDrag(input)
end
end)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
if not gameProcessed and input.KeyCode == Enum.KeyCode.Insert then
MainFrame.Visible = not MainFrame.Visible
end
end)
